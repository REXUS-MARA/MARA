
<dashboard-box >
    <dashboard-row>
        <dashboard-box title="Signals GPIO">
            <channel-table 
            filter-text="gpioWatcher"
            items-shown="gpioWatcher.LOState,gpioWatcher.SOEState,gpioWatcher.EODSState"/> 
        </dashboard-box>
    </dashboard-row>
        <dashboard-box title="Signals Orchestrator">
            <channel-table 
            filter-text="orchestrator"
            items-shown="orchestrator.Mode,orchestrator.PhaseSeconds"/> 
        </dashboard-box>
</dashboard-box>